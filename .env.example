# MakiAI — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Groq (Multi-Key Pool & Auto-Rotation) ────────────────────────────────────
# Get free keys at: https://console.groq.com/keys
# You can provide multiple comma-separated keys for auto-switching and infinite quota:
GROQ_API_KEYS=gsk_key1_here,gsk_key2_here,gsk_key3_here
GROQ_API_KEY=your_groq_api_key_here

# ─── Google Gemini (Multi-Key Pool & Vision) ──────────────────────────────────
# Get free keys at: https://aistudio.google.com/app/apikey
# You can provide multiple comma-separated keys:
GEMINI_API_KEYS=AIzaSy_key1_here,AIzaSy_key2_here
GEMINI_API_KEY=your_gemini_api_key_here

# ─── ElevenLabs TTS ──────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# ─── Picovoice Porcupine (Wake Word) ─────────────────────────────────────────
PORCUPINE_ACCESS_KEY=your_porcupine_access_key_here

# ─── Wake Word ───────────────────────────────────────────────────────────────
WAKE_WORD=Hey Maki

# ─── Knowledge Base & Local Storage ──────────────────────────────────────────
KB_PATH=C:\Knowledge-Base
MAKI_SYNC_PATH=C:\MakiSync Storage

# ─── App & User Customization ────────────────────────────────────────────────
APP_NAME=MakiAI
USER_NAME=Mark
APP_VERSION=1.0.0
DEBUG=false

# ─── Telegram Mobile Remote Bridge ───────────────────────────────────────────
# Get token from @BotFather, get user ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_telegram_numerical_user_id_here

# ─── Discord Live Voice Bridge ───────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_server_guild_id_here
DISCORD_VOICE_CHANNEL_ID=your_voice_channel_id_here
DISCORD_TEXT_CHANNEL_ID=your_text_channel_id_here

# ─── Twilio Live Phone Calling Bridge ───────────────────────────────────────
# Get free trial credentials at: https://console.twilio.com/
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_virtual_phone_number_here
TWILIO_AUTHORIZED_CALLER=your_personal_cell_phone_number_here

# ─── Suppress HuggingFace symlink warning ────────────────────────────────────
HF_HUB_DISABLE_SYMLINKS_WARNING=1

